{
  "globalExclude": ["desktop.ini", "thumbs.db", "*.lnk"],
  "rules": [
    { "id": "userTemp", "cat": "system", "title": "Fichiers temporaires", "hint": "%TEMP%, fichiers non modifiés depuis 7 jours",
      "kind": "files", "paths": ["%LOCALAPPDATA%/Temp"], "depth": 50, "olderThanDays": 7,
      "exclude": "avast*;avg*;*.lock", "excludeDirs": ["%LOCALAPPDATA%/Temp/claude", "%LOCALAPPDATA%/Temp/node-compile-cache", "%LOCALAPPDATA%/Temp/DiagOutputDir", "%LOCALAPPDATA%/Temp/wsl-crashes"], "default": true },
    { "id": "diagTraces", "cat": "system", "title": "Traces de diagnostic", "hint": "Fichiers .etl du Bureau à distance et d'autres outils, plus vieux d'un jour",
      "kind": "files", "paths": ["%LOCALAPPDATA%/Temp/DiagOutputDir"], "mask": "*.etl", "depth": 5, "olderThanDays": 1, "default": true },
    { "id": "wslCrashes", "cat": "system", "title": "Plantages WSL", "hint": "Vidages .dmp laissés par WSL",
      "kind": "files", "paths": ["%LOCALAPPDATA%/Temp/wsl-crashes"], "mask": "*.dmp", "depth": 2, "default": true },
    { "id": "winTemp", "cat": "system", "title": "Temp de Windows", "hint": "C:\\Windows\\Temp, ce qui est accessible sans droits admin",
      "kind": "files", "paths": ["%WINDIR%/Temp"], "depth": 50, "olderThanDays": 7, "default": true },
    { "id": "crashDumps", "cat": "system", "title": "Vidages mémoire", "hint": "Fichiers .dmp laissés par les plantages",
      "kind": "files", "paths": ["%LOCALAPPDATA%/CrashDumps"], "mask": "*.dmp", "depth": 2, "default": true },
    { "id": "werReports", "cat": "system", "title": "Rapports d'erreurs Windows", "hint": "WER : rapports déjà envoyés ou en attente",
      "kind": "files", "paths": ["%LOCALAPPDATA%/Microsoft/Windows/WER"], "depth": 10, "default": true },
    { "id": "thumbCache", "cat": "system", "title": "Cache des miniatures", "hint": "Explorateur, reconstruit à la demande",
      "kind": "files", "paths": ["%LOCALAPPDATA%/Microsoft/Windows/Explorer"], "mask": "thumbcache_*.db;iconcache_*.db", "depth": 0, "default": true },
    { "id": "d3dShaders", "cat": "system", "title": "Cache des shaders DirectX", "hint": "Recompilé par les jeux et le navigateur",
      "kind": "files", "paths": ["%LOCALAPPDATA%/D3DSCache"], "depth": 5, "default": true },
    { "id": "recycleBin", "cat": "system", "title": "Corbeille", "hint": "Vidée d'un coup, vérifie-la avant",
      "kind": "recycleBin", "default": false },

    { "id": "chromeCache", "cat": "browsers", "title": "Chrome : caches", "hint": "Cache, Code Cache, GPUCache, CacheStorage. Historique, mots de passe et cookies ne sont pas touchés",
      "kind": "files", "depth": 10, "default": true,
      "paths": ["%LOCALAPPDATA%/Google/Chrome/User Data/*/Cache", "%LOCALAPPDATA%/Google/Chrome/User Data/*/Code Cache",
                "%LOCALAPPDATA%/Google/Chrome/User Data/*/GPUCache", "%LOCALAPPDATA%/Google/Chrome/User Data/*/Service Worker/CacheStorage",
                "%LOCALAPPDATA%/Google/Chrome/User Data/GrShaderCache", "%LOCALAPPDATA%/Google/Chrome/User Data/ShaderCache"] },
    { "id": "edgeCache", "cat": "browsers", "title": "Edge : caches", "hint": "Les mêmes dossiers que Chrome",
      "kind": "files", "depth": 10, "default": true,
      "paths": ["%LOCALAPPDATA%/Microsoft/Edge/User Data/*/Cache", "%LOCALAPPDATA%/Microsoft/Edge/User Data/*/Code Cache",
                "%LOCALAPPDATA%/Microsoft/Edge/User Data/*/GPUCache", "%LOCALAPPDATA%/Microsoft/Edge/User Data/*/Service Worker/CacheStorage",
                "%LOCALAPPDATA%/Microsoft/Edge/User Data/GrShaderCache", "%LOCALAPPDATA%/Microsoft/Edge/User Data/ShaderCache"] },
    { "id": "browserCrash", "cat": "browsers", "title": "Rapports de plantage des navigateurs", "hint": "Crashpad de Chrome et Edge",
      "kind": "files", "depth": 5, "default": true,
      "paths": ["%LOCALAPPDATA%/Google/Chrome/User Data/Crashpad/reports", "%LOCALAPPDATA%/Microsoft/Edge/User Data/Crashpad/reports"] },

    { "id": "electronCaches", "cat": "apps", "title": "Applis Electron : caches", "hint": "Discord, VS Code, Slack, Teams, GitHub Desktop, Claude",
      "kind": "files", "depth": 10, "default": true,
      "paths": ["%APPDATA%/discord/Cache", "%APPDATA%/discord/Code Cache", "%APPDATA%/discord/GPUCache",
                "%APPDATA%/Code/Cache", "%APPDATA%/Code/CachedData", "%APPDATA%/Code/Code Cache", "%APPDATA%/Code/GPUCache", "%APPDATA%/Code/CachedExtensionVSIXs",
                "%APPDATA%/Cursor/Cache", "%APPDATA%/Cursor/CachedData", "%APPDATA%/Cursor/Code Cache",
                "%APPDATA%/Slack/Cache", "%APPDATA%/Slack/Code Cache", "%APPDATA%/Microsoft/Teams/Cache",
                "%APPDATA%/GitHub Desktop/Cache", "%APPDATA%/GitHub Desktop/Code Cache", "%APPDATA%/GitHub Desktop/GPUCache",
                "%APPDATA%/Claude/Cache", "%APPDATA%/Claude/Code Cache", "%APPDATA%/Claude/GPUCache"] },
    { "id": "steamCache", "cat": "apps", "title": "Steam : cache web", "hint": "htmlcache du client Steam",
      "kind": "files", "paths": ["%LOCALAPPDATA%/Steam/htmlcache"], "depth": 10, "default": true },
    { "id": "spotifyCache", "cat": "apps", "title": "Spotify : cache", "hint": "Morceaux mis en cache, retéléchargés à l'écoute",
      "kind": "files", "depth": 10, "default": true,
      "paths": ["%LOCALAPPDATA%/Packages/SpotifyAB.SpotifyMusic_*/LocalCache/Spotify/Data", "%LOCALAPPDATA%/Spotify/Data"] },
    { "id": "oneDriveLogs", "cat": "apps", "title": "OneDrive : journaux", "hint": "Fichiers .odl et .log",
      "kind": "files", "paths": ["%LOCALAPPDATA%/Microsoft/OneDrive/logs"], "depth": 5, "olderThanDays": 3, "default": true },

    { "id": "claudeSessions", "cat": "dev", "title": "Claude Code : anciennes sessions", "hint": "Dossiers de travail dans %TEMP%\\claude, inactifs depuis 3 jours",
      "kind": "children", "paths": ["%LOCALAPPDATA%/Temp/claude/*"], "olderThanDays": 3, "default": true },
    { "id": "npmCache", "cat": "dev", "title": "npm : cache des paquets", "hint": "_cacache, comme npm cache clean --force",
      "kind": "files", "paths": ["%LOCALAPPDATA%/npm-cache/_cacache"], "depth": 10, "default": true },
    { "id": "npxCache", "cat": "dev", "title": "npx : paquets temporaires", "hint": "Paquets lancés avec npx, pas utilisés depuis 14 jours",
      "kind": "children", "paths": ["%LOCALAPPDATA%/npm-cache/_npx"], "olderThanDays": 14, "default": true },
    { "id": "npmLogs", "cat": "dev", "title": "npm : journaux", "hint": "_logs",
      "kind": "files", "paths": ["%LOCALAPPDATA%/npm-cache/_logs"], "depth": 1, "default": true },
    { "id": "yarnPnpm", "cat": "dev", "title": "Yarn et pnpm : caches", "hint": "Les projets déjà installés gardent leurs fichiers",
      "kind": "files", "paths": ["%LOCALAPPDATA%/Yarn/Cache", "%LOCALAPPDATA%/pnpm-cache"], "depth": 10, "default": true },
    { "id": "pipUv", "cat": "dev", "title": "pip et uv : caches", "hint": "Wheels téléchargés",
      "kind": "files", "paths": ["%LOCALAPPDATA%/pip/Cache", "%LOCALAPPDATA%/uv/cache"], "depth": 20, "default": true },
    { "id": "gradleCaches", "cat": "dev", "title": "Gradle : caches inutilisés", "hint": "Entrées de ~/.gradle/caches pas utilisées depuis 30 jours",
      "kind": "children", "paths": ["%USERPROFILE%/.gradle/caches/*", "%USERPROFILE%/.gradle/caches/modules-2/files-2.1"], "olderThanDays": 30, "default": true },
    { "id": "gradleDaemon", "cat": "dev", "title": "Gradle : journaux du daemon", "hint": "Fichiers .log",
      "kind": "files", "paths": ["%USERPROFILE%/.gradle/daemon"], "mask": "*.log;*.out.log", "depth": 3, "default": true },
    { "id": "gradleWrappers", "cat": "dev", "title": "Gradle : anciennes versions", "hint": "Distributions du wrapper inutilisées depuis 60 jours",
      "kind": "children", "paths": ["%USERPROFILE%/.gradle/wrapper/dists"], "olderThanDays": 60, "default": true },
    { "id": "cargoCache", "cat": "dev", "title": "Cargo : archives du registre", "hint": "registry/cache et registry/src, ré-extraits au besoin",
      "kind": "children", "paths": ["%USERPROFILE%/.cargo/registry/cache/*", "%USERPROFILE%/.cargo/registry/src/*"], "olderThanDays": 30, "default": true },
    { "id": "nugetHttp", "cat": "dev", "title": "NuGet : cache HTTP", "hint": "v3-cache et plugins-cache",
      "kind": "files", "paths": ["%LOCALAPPDATA%/NuGet/v3-cache", "%LOCALAPPDATA%/NuGet/plugins-cache"], "depth": 5, "default": true },
    { "id": "goBuild", "cat": "dev", "title": "Go : cache de compilation", "hint": "go-build",
      "kind": "files", "paths": ["%LOCALAPPDATA%/go-build"], "depth": 5, "default": true },
    { "id": "playwright", "cat": "dev", "title": "Playwright : navigateurs", "hint": "À réinstaller avec npx playwright install",
      "kind": "children", "paths": ["%LOCALAPPDATA%/ms-playwright"], "olderThanDays": 30, "default": false },
    { "id": "nodeCompile", "cat": "dev", "title": "Node : cache de compilation", "hint": "node-compile-cache",
      "kind": "files", "paths": ["%LOCALAPPDATA%/Temp/node-compile-cache"], "depth": 5, "default": true }
  ]
}
